<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>404 - Page Not Found</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; }
        .error-container { margin-top: 100px; }
    </style>
</head>
<body>
    <div class="container text-center error-container">
        <h1 class="display-1 text-muted">404</h1>
        <h2 class="mb-3">Oops! Page not found.</h2>
        <p class="lead">The page you are looking for doesn't exist.</p>
        <a href="/dashboard" class="btn btn-primary mt-3">Go to Dashboard</a>
    </div>
</body>
</html>