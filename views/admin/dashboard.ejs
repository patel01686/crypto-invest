<div class="row g-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <h5>Total Users</h5>
                <h2><%= totalUsers %></h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow">
            <div class="card-body">
                <h5>Pending Deposits</h5>
                <h2><%= pendingDeposits %></h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white shadow">
            <div class="card-body">
                <h5>Pending Withdrawals</h5>
                <h2><%= pendingWithdrawals %></h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <h5>Total Investments</h5>
                <h2><%= totalInvestments %></h2>
            </div>
        </div>
    </div>
</div>