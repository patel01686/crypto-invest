<div class="card shadow">
    <div class="card-header bg-transparent">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>All User Investments</h5>
            <span class="badge bg-primary"><%= investments.length %> Total</span>
        </div>

        <!-- ===== FILTER TABS ===== -->
        <ul class="nav nav-pills mt-3" id="investmentFilter" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="filter-all" data-filter="all" type="button">
                    All
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="filter-active" data-filter="active" type="button">
                    <i class="fas fa-circle text-success me-1" style="font-size:8px;"></i> Active
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="filter-matured" data-filter="matured" type="button">
                    <i class="fas fa-circle text-secondary me-1" style="font-size:8px;"></i> Matured
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body">
        <% if (investments && investments.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" id="investmentsTable">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Plan</th>
                            <th>Amount</th>
                            <th>Return</th>
                            <th>Start</th>
                            <th>Maturity</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% investments.forEach(inv => { %>
                            <tr data-status="<%= inv.status %>">
                                <td>
                                    <strong><%= inv.user ? inv.user.fullName : 'Deleted' %></strong><br>
                                    <small class="text-muted"><%= inv.user ? inv.user.email : '' %></small>
                                </td>
                                <td><%= inv.plan ? inv.plan.name : 'N/A' %></td>
                                <td>₹<%= inv.amount.toFixed(2) %></td>
                                <td><%= inv.plan ? inv.plan.returnRate + '%' : 'N/A' %></td>
                                <td><%= new Date(inv.startDate).toLocaleDateString() %></td>
                                <td><%= new Date(inv.maturityDate).toLocaleDateString() %></td>
                                <td>
                                    <span class="badge <%= inv.status === 'active' ? 'bg-success' : inv.status === 'matured' ? 'bg-secondary' : 'bg-danger' %>">
                                        <%= inv.status %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/admin/investments/delete/<%= inv._id %>"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Pakka delete karna hai? Yeh permanent hai.')">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-muted">No investments found.</p>
        <% } %>
    </div>
</div>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function() {
        const table = $('#investmentsTable').DataTable({
            order: [[4, 'desc']],
            pageLength: 25,
            language: {
                emptyTable: "No investments found"
            }
        });

        // Custom filter buttons
        $('#investmentFilter .nav-link').on('click', function() {
            $('#investmentFilter .nav-link').removeClass('active');
            $(this).addClass('active');

            const filter = $(this).data('filter');
            if (filter === 'all') {
                table.column(6).search('').draw();
            } else {
                // Search in Status column (column index 6)
                table.column(6).search(filter === 'active' ? '^active$' : '^matured$', true, false).draw();
            }
        });
    });
</script>