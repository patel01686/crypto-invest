<div class="card shadow">
    <div class="card-header bg-transparent">
        <h5 class="mb-0">All Users</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr><th>Name</th><th>Email</th><th>Wallet</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                <% users.forEach(u => { %>
                    <tr>
                        <td><%= u.fullName %></td>
                        <td><%= u.email %></td>
                        <td>₹<%= u.walletBalance.toFixed(2) %></td>
                        <td><span class="badge <%= u.isActive ? 'bg-success' : 'bg-danger' %>"><%= u.isActive ? 'Active' : 'Inactive' %></span></td>
                        <td>
                            <a href="/admin/users/toggle/<%= u._id %>" class="btn btn-sm btn-warning"><%= u.isActive ? 'Deactivate' : 'Activate' %></a>
                            <form action="/admin/users/adjust-balance" method="POST" class="d-inline">
                                <input type="hidden" name="userId" value="<%= u._id %>">
                                <input type="number" name="amount" placeholder="Amount" step="any" required style="width:80px;">
                                <select name="action" class="form-select-sm d-inline">
                                    <option value="add">Add</option>
                                    <option value="deduct">Deduct</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Adjust</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>