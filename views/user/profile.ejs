<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>Your Profile</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <style>
        /* ===== RESET & BASE ===== */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f4f6fa;
            background-image: radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.6) 0%, #eef1f5 90%);
            padding: 1.25rem;
            margin: 0;
        }

        .container {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
        }

        /* ===== ROW & COLUMNS ===== */
        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .col-md-8 {
            flex: 0 0 calc(66.666% - 0.75rem);
            max-width: calc(66.666% - 0.75rem);
        }

        .col-md-4 {
            flex: 0 0 calc(33.333% - 0.75rem);
            max-width: calc(33.333% - 0.75rem);
        }

        /* ===== CARDS ===== */
        .card {
            background: #ffffff;
            border: none !important;
            border-radius: 2rem !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), 0 8px 20px rgba(0, 0, 0, 0.03) !important;
            transition: transform 0.25s ease, box-shadow 0.3s ease;
            overflow: hidden;
            height: 100%;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.08), 0 12px 28px rgba(0, 0, 0, 0.04) !important;
        }

        /* ===== CARD HEADER ===== */
        .card-header {
            background: transparent !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04) !important;
            padding: 1.25rem 1.5rem !important;
            border-radius: 2rem 2rem 0 0 !important;
        }

        .card-header h5 {
            font-weight: 700;
            font-size: 1.2rem;
            color: #0f172a;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .card-header h5 i {
            color: #2563eb;
            font-size: 1.1rem;
        }

        /* ===== CARD BODY ===== */
        .card-body {
            padding: 1.25rem 1.5rem 1.75rem !important;
        }

        /* ===== PROFILE INFO (left card) ===== */
        .card-body p {
            margin-bottom: 0.6rem;
            font-size: 0.95rem;
            color: #1e293b;
            padding: 0.4rem 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .card-body p:last-of-type {
            border-bottom: none;
        }

        .card-body p strong {
            font-weight: 600;
            color: #0f172a;
            display: inline-block;
            min-width: 130px;
        }

        /* ===== BANK ACCOUNTS (right card) ===== */
        .list-group {
            list-style: none;
            padding: 0;
            margin: 0 0 1rem 0;
        }

        .list-group-item {
            background: #fafbfc;
            border: 1px solid #e9edf2;
            border-radius: 0.85rem !important;
            padding: 0.75rem 1rem;
            margin-bottom: 0.6rem;
            transition: background 0.2s;
        }

        .list-group-item:hover {
            background: #f1f4f8;
        }

        .list-group-item strong {
            color: #0f172a;
            font-weight: 600;
        }

        .list-group-item div {
            font-size: 0.9rem;
            color: #334155;
            margin-bottom: 0.15rem;
        }

        .list-group-item div:last-of-type {
            margin-bottom: 0.4rem;
        }

        .list-group-item .btn-danger {
            background: #fee2e2;
            border: none;
            color: #991b1b;
            border-radius: 2rem;
            padding: 0.2rem 0.8rem;
            font-size: 0.75rem;
            font-weight: 600;
            transition: all 0.2s;
        }

        .list-group-item .btn-danger:hover {
            background: #fecaca;
            transform: translateY(-1px);
        }

        .text-muted {
            color: #64748b !important;
            font-size: 0.95rem;
            margin-bottom: 0.5rem;
        }

        hr {
            border: 0;
            height: 1px;
            background: #e9edf2;
            margin: 1.5rem 0 1rem;
        }

        /* ===== ADD ACCOUNT FORM ===== */
        h6 {
            font-weight: 700;
            font-size: 1rem;
            color: #0f172a;
            margin-bottom: 0.75rem;
        }

        .form-control {
            background: #ffffff !important;
            border: 1.5px solid #e2e8f0 !important;
            border-radius: 0.85rem !important;
            padding: 0.6rem 1rem !important;
            color: #1e293b !important;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.25s ease;
            width: 100%;
            outline: none;
        }

        .form-control:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08) !important;
            background: #ffffff !important;
        }

        .form-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .form-control:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 1000px #fff inset !important;
            -webkit-text-fill-color: #1e293b !important;
        }

        .mb-2 {
            margin-bottom: 0.6rem !important;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
            border: none !important;
            border-radius: 0.85rem !important;
            padding: 0.6rem 1.2rem !important;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.3px;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
            transition: all 0.25s ease;
            cursor: pointer;
            width: 100%;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
            background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        /* ============================================ */
        /* ===== RESPONSIVE – MOBILE FIRST ===== */
        /* ============================================ */

        @media (max-width: 767.98px) {
            .col-md-8,
            .col-md-4 {
                flex: 0 0 100%;
                max-width: 100%;
            }

            body {
                padding: 0.75rem;
            }

            .card {
                border-radius: 1.5rem !important;
            }

            .card-header {
                padding: 1rem 1.25rem !important;
            }
            .card-header h5 {
                font-size: 1.05rem;
            }
            .card-body {
                padding: 1rem 1.25rem 1.25rem !important;
            }

            .card-body p {
                font-size: 0.85rem;
                padding: 0.3rem 0;
            }
            .card-body p strong {
                min-width: 100px;
            }

            .list-group-item {
                padding: 0.6rem 0.8rem;
                font-size: 0.85rem;
            }
            .list-group-item div {
                font-size: 0.8rem;
            }
            .form-control {
                font-size: 0.85rem;
                padding: 0.5rem 0.8rem !important;
            }
            .btn-primary {
                font-size: 0.85rem;
                padding: 0.5rem 1rem !important;
            }
            hr {
                margin: 1rem 0 0.75rem;
            }
        }

        @media (max-width: 575.98px) {
            .card-header {
                padding: 0.8rem 1rem !important;
            }
            .card-body {
                padding: 0.8rem 1rem 1rem !important;
            }
            .card-body p {
                font-size: 0.8rem;
                padding: 0.25rem 0;
            }
            .card-body p strong {
                min-width: 80px;
            }
            .list-group-item {
                padding: 0.5rem 0.7rem;
                font-size: 0.8rem;
                border-radius: 0.7rem !important;
            }
            .list-group-item div {
                font-size: 0.75rem;
            }
            .list-group-item .btn-danger {
                font-size: 0.65rem;
                padding: 0.1rem 0.6rem;
            }
            .form-control {
                font-size: 0.8rem;
                padding: 0.4rem 0.7rem !important;
                border-radius: 0.7rem !important;
            }
            .btn-primary {
                font-size: 0.8rem;
                padding: 0.4rem 0.8rem !important;
                border-radius: 0.7rem !important;
            }
            h6 {
                font-size: 0.9rem;
            }
            .text-muted {
                font-size: 0.8rem;
            }
            hr {
                margin: 0.75rem 0;
            }
        }

        /* ============================================ */
        /* ===== TOUCH / CLICK IMPROVEMENTS ===== */
        /* ============================================ */
        @media (hover: none) and (pointer: coarse) {
            .card:hover {
                transform: none !important;
            }
            .btn-primary:hover,
            .list-group-item .btn-danger:hover {
                transform: none !important;
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15) !important;
            }
            .list-group-item:hover {
                background: #fafbfc;
            }
        }

        /* ============================================ */
        /* ===== SAFE AREA ===== */
        /* ============================================ */
        @supports (padding: max(0px)) {
            body {
                padding-left: max(0.75rem, env(safe-area-inset-left));
                padding-right: max(0.75rem, env(safe-area-inset-right));
                padding-top: max(0.75rem, env(safe-area-inset-top));
                padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
            }
        }

        /* ============================================ */
        /* ===== REDUCED MOTION ===== */
        /* ============================================ */
        @media (prefers-reduced-motion: reduce) {
            .card,
            .btn-primary,
            .list-group-item .btn-danger,
            .form-control {
                transition: none !important;
                animation: none !important;
            }
            .card:hover {
                transform: none !important;
            }
            .btn-primary:hover,
            .list-group-item .btn-danger:hover {
                transform: none !important;
            }
            .list-group-item:hover {
                background: #fafbfc;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Original markup – completely untouched, with all EJS logic -->
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">Your Profile</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Name:</strong> <%= user.fullName %></p>
                        <p><strong>Email:</strong> <%= user.email %></p>
                        <p><strong>Phone:</strong> <%= user.phone %></p>
                        <p><strong>Wallet Balance:</strong> ₹<%= user.walletBalance ? user.walletBalance.toFixed(2) : '0.00' %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">Bank Accounts</h5>
                    </div>
                    <div class="card-body">
                        <% if (user.bankAccounts && user.bankAccounts.length) { %>
                            <ul class="list-group">
                                <% user.bankAccounts.forEach(acc => { %>
                                    <li class="list-group-item">
                                        <div><strong><%= acc.accountHolder %></strong></div>
                                        <div><%= acc.bankName %> - <%= acc.accountNumber %></div>
                                        <div>IFSC: <%= acc.ifscCode %></div>
                                        <a href="/profile/remove-bank/<%= acc._id %>" class="btn btn-sm btn-danger mt-1" onclick="return confirm('Remove this account?')">Remove</a>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-muted">No bank accounts added.</p>
                        <% } %>
                        <hr>
                        <h6>Add New Bank Account</h6>
                        <form action="/profile/add-bank" method="POST">
                            <div class="mb-2">
                                <input type="text" class="form-control" name="accountHolder" placeholder="Account Holder Name" required>
                            </div>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="bankName" placeholder="Bank Name" required>
                            </div>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="accountNumber" placeholder="Account Number" required>
                            </div>
                            <div class="mb-2">
                                <input type="text" class="form-control" name="ifscCode" placeholder="IFSC Code" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Add Account</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>