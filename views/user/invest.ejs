<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>Investment Plans</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <style>
        /* ===== RESET & BASE ===== */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f4f6fa;
            background-image: radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.6) 0%, #eef1f5 90%);
            padding: 2rem 1.25rem;
            margin: 0;
        }

        .container {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
        }

        /* ===== PAGE HEADER ===== */
        .page-header {
            margin-bottom: 2rem;
            text-align: center;
        }

        .page-header h2 {
            font-weight: 700;
            font-size: 2rem;
            color: #0f172a;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
        }

        .page-header h2 i {
            color: #2563eb;
        }

        .page-header p {
            color: #475569;
            font-size: 1.05rem;
            margin-top: 0.25rem;
        }

        /* ===== GRID ===== */
        .row.g-4 {
            --bs-gutter-y: 1.5rem;
            --bs-gutter-x: 1.5rem;
        }

        /* ===== PLAN CARDS ===== */
        .plan-card {
            background: #ffffff;
            border: none !important;
            border-radius: 1.5rem !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04), 0 2px 8px rgba(0, 0, 0, 0.02) !important;
            transition: transform 0.25s ease, box-shadow 0.3s ease;
            height: 100%;
            overflow: hidden;
        }

        .plan-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06), 0 8px 16px rgba(0, 0, 0, 0.02) !important;
        }

        .plan-card .card-body {
            padding: 1.75rem 1.5rem !important;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        /* ===== CARD TITLE ===== */
        .plan-card .card-title {
            font-weight: 700;
            font-size: 1.25rem;
            color: #0f172a;
            margin-bottom: 0.5rem;
        }

        /* ===== CARD TEXT ===== */
        .plan-card .card-text {
            color: #64748b !important;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 0.75rem;
            flex-grow: 0;
        }

        /* ===== PLAN FEATURES LIST ===== */
        .plan-card .list-unstyled {
            margin-top: 0.5rem !important;
            margin-bottom: 1rem !important;
            padding: 0;
        }

        .plan-card .list-unstyled li {
            padding: 0.35rem 0;
            color: #1e293b;
            font-weight: 500;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #f1f5f9;
        }

        .plan-card .list-unstyled li:last-child {
            border-bottom: none;
        }

        .plan-card .list-unstyled li i {
            width: 1.4rem;
            font-size: 1rem;
            margin-right: 0.6rem;
            text-align: center;
        }

        .plan-card .list-unstyled li i.fa-percent {
            color: #16a34a;
        }
        .plan-card .list-unstyled li i.fa-calendar-alt {
            color: #f59e0b;
        }
        .plan-card .list-unstyled li i.fa-coins {
            color: #8b5cf6;
        }

        /* ===== FORM - CLEAN INPUT ===== */
        .plan-card form {
            margin-top: auto;
        }

        /* --- Clean input without input-group --- */
        .plan-card .form-control {
            background: #ffffff !important;
            border: 1.5px solid #e2e8f0 !important;
            border-radius: 0.85rem !important;
            padding: 0.7rem 1rem !important;
            color: #1e293b !important;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.25s ease;
            outline: none;
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.01);
            width: 100%;
            margin-bottom: 0.75rem !important;
            text-align: left;
        }

        .plan-card .form-control:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08) !important;
            background: #ffffff !important;
        }

        .plan-card .form-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
            letter-spacing: 0.3px;
        }

        .plan-card .form-control:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 1000px #fff inset !important;
            -webkit-text-fill-color: #1e293b !important;
        }

        /* ===== INVEST BUTTON ===== */
        .plan-card .btn-success {
            background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
            border: none !important;
            border-radius: 0.85rem !important;
            padding: 0.7rem 1.2rem !important;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 0.3px;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
            transition: all 0.25s ease;
            cursor: pointer;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .plan-card .btn-success::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, transparent 40%, rgba(255, 255, 255, 0.08) 100%);
            pointer-events: none;
        }

        .plan-card .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
            background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
        }

        .plan-card .btn-success:active {
            transform: scale(0.97);
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.10);
        }

        /* ===== ALERT ===== */
        .alert-info {
            background: #eff6ff;
            border: 1px solid #dbeafe;
            color: #1e3a8a;
            border-radius: 1rem;
            padding: 1.5rem;
            text-align: center;
            font-weight: 500;
            font-size: 1.1rem;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 575.98px) {
            body {
                padding: 1rem 0.75rem;
            }
            .page-header h2 {
                font-size: 1.5rem;
            }
            .page-header p {
                font-size: 0.9rem;
            }
            .plan-card {
                border-radius: 1.25rem !important;
            }
            .plan-card .card-body {
                padding: 1.25rem !important;
            }
            .plan-card .card-title {
                font-size: 1.1rem;
            }
            .plan-card .list-unstyled li {
                font-size: 0.85rem;
                padding: 0.25rem 0;
            }
            .plan-card .form-control {
                font-size: 0.85rem;
                padding: 0.6rem 0.85rem !important;
            }
            .plan-card .btn-success {
                font-size: 0.85rem;
                padding: 0.6rem 1rem !important;
            }
        }

        @media (min-width: 576px) and (max-width: 767.98px) {
            .plan-card .card-body {
                padding: 1.5rem !important;
            }
        }

        @media (min-width: 768px) and (max-width: 991.98px) {
            .plan-card .card-body {
                padding: 1.75rem !important;
            }
        }

        /* ===== TOUCH ===== */
        @media (hover: none) and (pointer: coarse) {
            .plan-card:hover {
                transform: none !important;
            }
            .plan-card .btn-success:hover {
                transform: none !important;
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15) !important;
            }
        }

        /* ===== SAFE AREA ===== */
        @supports (padding: max(0px)) {
            body {
                padding-left: max(1.25rem, env(safe-area-inset-left));
                padding-right: max(1.25rem, env(safe-area-inset-right));
                padding-top: max(1.25rem, env(safe-area-inset-top));
                padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
            }
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            .plan-card,
            .plan-card .btn-success,
            .plan-card .form-control {
                transition: none !important;
                animation: none !important;
            }
            .plan-card:hover {
                transform: none !important;
            }
            .plan-card .btn-success:hover {
                transform: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-chart-line"></i> Investment Plans</h2>
            <p>Choose a plan and start growing your wealth</p>
        </div>

        <!-- Original markup – only the input inside the form has been improved -->
        <div class="row g-4">
            <% if (plans && plans.length > 0) { %>
                <% plans.forEach(plan => { %>
                    <div class="col-md-4 col-sm-6 col-12">
                        <div class="card shadow h-100 border-0 plan-card">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= plan.name %></h5>
                                <p class="card-text text-muted small"><%= plan.description || '' %></p>
                                <ul class="list-unstyled mt-2">
                                    <li><i class="fas fa-percent text-success me-2"></i><%= plan.returnRate %>%</li>
                                    <li><i class="fas fa-calendar-alt me-2"></i><%= plan.tenureDays %> days</li>
                                    <li><i class="fas fa-coins me-2"></i>₹<%= plan.minAmount %> – ₹<%= plan.maxAmount %></li>
                                </ul>
                                <form action="/invest" method="POST" class="mt-auto">
                                    <input type="hidden" name="planId" value="<%= plan._id %>">
                                    <!-- Clean unified input – ₹ symbol now inside placeholder -->
                                    <input type="number" 
                                           class="form-control" 
                                           name="amount" 
                                           placeholder="₹ 1000" 
                                           min="<%= plan.minAmount %>" 
                                           max="<%= plan.maxAmount %>" 
                                           required>
                                    <button type="submit" class="btn btn-success w-100">Invest Now</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-info text-center">No active plans.</div>
                </div>
            <% } %>
        </div>
    </div>

</body>
</html>