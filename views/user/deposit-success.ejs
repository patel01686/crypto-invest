<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-success">
            <div class="card-body text-center">
                <i class="fas fa-check-circle text-success display-1"></i>
                <h3 class="mt-3">Deposit Request Submitted ✅</h3>
                <p class="lead">Your deposit of <strong>₹<%= transaction.amount.toFixed(2) %></strong> has been recorded.</p>
                <p>Status: <span class="badge bg-warning">Pending Verification</span></p>
                <p><strong>UTR:</strong> <%= transaction.metadata.utr %></p>
                
                <hr>
                <p class="text-muted">Please send the payment notification to the admin via Telegram:</p>
                
                
              <a href="https://t.me/coiinswitch"
   target="_blank"
   class="btn btn-primary btn-lg mt-2">
   <i class="fab fa-telegram me-2"></i> Send Notification to Admin
</a>
                
               
                <a href="/dashboard" class="btn btn-outline-primary mt-3">Back to Dashboard</a>
            </div>
        </div>
    </div>
</div>