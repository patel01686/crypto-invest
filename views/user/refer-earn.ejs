<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>Refer & Earn</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #eef2ff 0%, #f5f7fa 100%);
            min-height: 100vh;
            padding: 1.5rem 1rem;
            color: #1e293b;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        /* HEADER */
        .page-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }
        .page-header p {
            color: #64748b;
            font-size: 0.95rem;
        }

        /* HERO CARD */
        .hero-card {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
            border-radius: 24px;
            padding: 2rem 1.5rem;
            text-align: center;
            color: #fff;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(79, 70, 229, 0.3);
        }
        .hero-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.15), transparent 70%);
            border-radius: 50%;
        }
        .hero-emoji {
            font-size: 3rem;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
        }
        .hero-card h2 {
            font-size: 1.6rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
            color: #fff;
        }
        .hero-card p {
            font-size: 0.95rem;
            opacity: 0.95;
            position: relative;
            z-index: 1;
            margin: 0;
            color: #fff;
        }
        .hero-card .earn-row {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 1.2rem;
            position: relative;
            z-index: 1;
            flex-wrap: wrap;
        }
        .earn-badge {
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            padding: 0.6rem 1.2rem;
            border-radius: 30px;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid rgba(255,255,255,0.2);
        }

        /* CARD */
        .card {
            background: #fff;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            border: 1px solid rgba(79, 70, 229, 0.06);
        }
        .card h3 {
            font-size: 1rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card h3 i {
            color: #4f46e5;
        }

        /* CODE BOX */
        .code-display {
            background: linear-gradient(135deg, #f5f7ff, #eef2ff);
            border: 2px dashed #c7d2fe;
            border-radius: 14px;
            padding: 1.2rem;
            text-align: center;
            margin-bottom: 1rem;
        }
        .code-display .code-text {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 4px;
            color: #4f46e5;
            font-family: 'Courier New', monospace;
            word-break: break-all;
        }
        .code-display .code-label {
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        /* INPUT GROUP */
        .input-group {
            display: flex;
            gap: 8px;
            margin-bottom: 1rem;
        }
        .input-group input {
            flex: 1;
            background: #fafbff;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.7rem 1rem;
            font-size: 0.85rem;
            color: #1e293b;
            font-family: inherit;
            font-weight: 500;
            outline: none;
            transition: all 0.25s;
            min-width: 0;
            text-overflow: ellipsis;
        }
        .input-group input:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        }
        .input-group button {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 0.7rem 1.2rem;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.25s;
            white-space: nowrap;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
        }
        .input-group button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35);
        }
        .input-group button:active {
            transform: scale(0.96);
        }

        /* SHARE BUTTONS */
        .share-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .share-btn {
            flex: 1;
            min-width: 140px;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.85rem;
            text-decoration: none;
            text-align: center;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.25s;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }
        .share-whatsapp {
            background: #25D366;
            color: #fff;
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
        }
        .share-whatsapp:hover {
            background: #1ebe5a;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.4);
            color: #fff;
        }
        .share-native {
            background: #f1f5f9;
            color: #334155;
            border: 1.5px solid #e2e8f0;
        }
        .share-native:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

        /* STATS GRID */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            background: #fff;
            border-radius: 20px;
            padding: 1.25rem;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            border: 1px solid rgba(79, 70, 229, 0.06);
            transition: transform 0.25s;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
        .stat-card .stat-emoji {
            font-size: 1.8rem;
            margin-bottom: 0.3rem;
        }
        .stat-card h3 {
            font-size: 1.8rem;
            font-weight: 800;
            color: #4f46e5;
            margin: 0.2rem 0;
            justify-content: center;
        }
        .stat-card small {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 500;
        }

        /* REFERRALS LIST */
        .referral-list {
            list-style: none;
        }
        .referral-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.9rem 1rem;
            background: linear-gradient(135deg, #fafbff, #f8faff);
            border: 1px solid #eef2ff;
            border-radius: 14px;
            margin-bottom: 0.6rem;
            gap: 10px;
        }
        .referral-item .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            flex: 1;
        }
        .referral-item .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .referral-item .user-details {
            min-width: 0;
            flex: 1;
        }
        .referral-item .user-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .referral-item .user-email {
            font-size: 0.78rem;
            color: #64748b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .referral-item .bonus-tag {
            background: #dcfce7;
            color: #15803d;
            padding: 0.3rem 0.7rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .empty-state {
            text-align: center;
            padding: 1.5rem 1rem;
            color: #94a3b8;
        }
        .empty-state .empty-emoji {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        .empty-state p {
            margin: 0;
            font-size: 0.9rem;
        }

        /* TOAST */
        .toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #10b981;
            color: #fff;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
            z-index: 9999;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .toast.show { opacity: 1; }

        /* MOBILE */
        @media (max-width: 576px) {
            body { padding: 1rem 0.75rem; }
            .page-header h1 { font-size: 1.5rem; }
            .hero-card { padding: 1.5rem 1rem; border-radius: 20px; }
            .hero-card h2 { font-size: 1.3rem; }
            .code-display .code-text { font-size: 1.2rem; letter-spacing: 2px; }
            .card { padding: 1.1rem; }
            .stats-grid { gap: 0.7rem; }
            .stat-card { padding: 1rem 0.5rem; }
            .stat-card h3 { font-size: 1.4rem; }
            .stat-card small { font-size: 0.7rem; }
            .share-row { flex-direction: column; }
            .share-btn { width: 100%; }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <h1>🎁 Refer & Earn</h1>
        <p>Invite friends and earn rewards instantly</p>
    </div>

    <!-- HERO CARD -->
    <div class="hero-card">
        <div class="hero-emoji">💰</div>
        <h2>Earn ₹500 Per Referral</h2>
        <p>Share your code. When your friend signs up, you both win!</p>
        <div class="earn-row">
            <div class="earn-badge">You get ₹500</div>
            <div class="earn-badge">They get ₹300</div>
        </div>
    </div>

    <!-- REFERRAL CODE CARD -->
    <div class="card">
        <h3><i class="fas fa-key"></i> Your Referral Code</h3>

        <div class="code-display">
            <div class="code-label">Share this code</div>
            <div class="code-text"><%= user.referralCode || 'N/A' %></div>
        </div>

        <div class="input-group">
            <input type="text" id="myRefCode" value="<%= user.referralCode || 'N/A' %>" readonly>
            <button onclick="copyRefCode()"><i class="fas fa-copy"></i> Copy</button>
        </div>
    </div>

    <!-- SHAREABLE LINK CARD -->
    <div class="card">
        <h3><i class="fas fa-link"></i> Your Shareable Link</h3>

        <div class="input-group">
            <input type="text" id="myRefLink" 
                   value="<%= (process.env.BASE_URL || 'http://localhost:3000') %>/register?ref=<%= user.referralCode || '' %>" readonly>
            <button onclick="copyRefLink()"><i class="fas fa-copy"></i> Copy</button>
        </div>

        <div class="share-row">
            <a href="https://wa.me/?text=<%= encodeURIComponent('Join this amazing investment platform! Use my referral code: ' + (user.referralCode || '') + ' - ' + (process.env.BASE_URL || 'http://localhost:3000') + '/register?ref=' + (user.referralCode || '')) %>" 
               target="_blank" class="share-btn share-whatsapp">
                <i class="fab fa-whatsapp"></i> Share on WhatsApp
            </a>
            <button onclick="shareNative()" class="share-btn share-native">
                <i class="fas fa-share-alt"></i> Share
            </button>
        </div>
    </div>

    <!-- STATS -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-emoji">👥</div>
            <h3><%= user.referrals ? user.referrals.length : 0 %></h3>
            <small>Total Referrals</small>
        </div>
        <div class="stat-card">
            <div class="stat-emoji">💵</div>
            <h3>₹<%= (user.referrals ? user.referrals.length : 0) * 500 %></h3>
            <small>Referral Earnings</small>
        </div>
    </div>

    <!-- REFERRED USERS -->
    <div class="card">
        <h3><i class="fas fa-users"></i> People You Referred</h3>

        <% if (user.referrals && user.referrals.length > 0) { %>
            <ul class="referral-list">
                <% user.referrals.forEach(ref => { %>
                    <li class="referral-item">
                        <div class="user-info">
                            <div class="user-avatar">
                                <%= (ref.fullName || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <div class="user-details">
                                <div class="user-name"><%= ref.fullName || 'User' %></div>
                                <div class="user-email"><%= ref.email || '' %></div>
                            </div>
                        </div>
                        <span class="bonus-tag">+₹500</span>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-emoji">📭</div>
                <p>No referrals yet</p>
                <p style="font-size:0.8rem; margin-top:0.3rem;">Share your link to start earning!</p>
            </div>
        <% } %>
    </div>

</div>

<!-- TOAST -->
<div id="toast" class="toast"></div>

<script>
    function showToast(msg) {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2200);
    }

    function copyRefCode() {
        const input = document.getElementById('myRefCode');
        input.select();
        input.setSelectionRange(0, 99999);
        try {
            document.execCommand('copy');
            showToast('✅ Referral code copied!');
        } catch (e) {
            navigator.clipboard.writeText(input.value);
            showToast('✅ Referral code copied!');
        }
    }

    function copyRefLink() {
        const input = document.getElementById('myRefLink');
        input.select();
        input.setSelectionRange(0, 99999);
        try {
            document.execCommand('copy');
            showToast('✅ Referral link copied!');
        } catch (e) {
            navigator.clipboard.writeText(input.value);
            showToast('✅ Referral link copied!');
        }
    }

    function shareNative() {
        const link = document.getElementById('myRefLink').value;
        if (navigator.share) {
            navigator.share({
                title: 'Join Crypto Invest',
                text: 'Get ₹300 signup bonus! Use my referral link:',
                url: link
            }).catch(() => {});
        } else {
            copyRefLink();
        }
    }
</script>

</body>
</html>