<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>Deposit Funds</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <style>
        /* ===== RESET & BASE ===== */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f4f6fa;
            background-image: radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.6) 0%, #eef1f5 90%);
            padding: 1.25rem;
            margin: 0;
        }

        /* ===== CARD ===== */
        .card {
            background: #ffffff;
            border: none !important;
            border-radius: 2rem !important;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), 0 8px 20px rgba(0, 0, 0, 0.03) !important;
            overflow: hidden;
            width: 100%;
        }

        /* ===== CARD HEADER ===== */
        .card-header {
            background: transparent !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04) !important;
            padding: 1.75rem 2rem !important;
        }

        .card-header h4 {
            color: #1a2634;
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: -0.3px;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin: 0;
        }

        .card-header h4 i {
            color: #2563eb;
            font-size: 1.4rem;
        }

        /* ===== CARD BODY ===== */
        .card-body {
            padding: 2rem 2rem 2.25rem !important;
            color: #1e293b;
        }

        /* ============================================================ */
        /* ===== TABS — FULLY RESPONSIVE, CLEAN, WELL-ALIGNED ===== */
        /* ============================================================ */
        .nav-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            background: #f1f4f9;
            padding: 0.5rem;
            border-radius: 1.25rem;
            margin-bottom: 1.75rem;
        }

        .nav-pills .nav-item {
            flex: 1 1 auto;
            min-width: 0;
        }

        .nav-pills .nav-link {
            background: transparent !important;
            border: none !important;
            border-radius: 1rem !important;
            padding: 0.65rem 0.75rem !important;
            font-weight: 600;
            font-size: 0.82rem;
            color: #475569 !important;
            transition: all 0.25s ease;
            text-align: center;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            width: 100%;
            letter-spacing: 0.2px;
        }

        .nav-pills .nav-link i {
            font-size: 0.95rem;
            color: #64748b;
            transition: color 0.25s ease;
        }

        .nav-pills .nav-link:hover {
            background: rgba(37, 99, 235, 0.06) !important;
            color: #1e293b !important;
        }

        .nav-pills .nav-link:hover i {
            color: #2563eb;
        }

        .nav-pills .nav-link.active {
            background: #ffffff !important;
            color: #2563eb !important;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.12), 0 1px 3px rgba(0, 0, 0, 0.03) !important;
            font-weight: 700;
        }

        .nav-pills .nav-link.active i {
            color: #2563eb !important;
        }

        /* ===== TAB CONTENT — QR + ADDRESS ===== */
        .tab-pane {
            padding: 0.25rem 0 0.5rem;
        }

        .tab-pane .text-center {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .tab-pane .text-center img {
            border-radius: 1.25rem !important;
            border: 2px solid #e9edf2 !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04) !important;
            max-width: 180px;
            width: 100%;
            height: auto;
            background: #ffffff;
            padding: 0.6rem;
            transition: transform 0.25s ease;
        }

        .tab-pane .text-center img:hover {
            transform: scale(1.02);
        }

        /* --- UPI ID / Wallet Address Row --- */
        .address-row {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.75rem;
            width: 100%;
            padding: 0 0.25rem;
        }

        .address-row .address-text {
            font-weight: 700;
            color: #2563eb;
            background: #eff6ff;
            padding: 0.3rem 1rem;
            border-radius: 2rem;
            border: 1px solid #dbeafe;
            font-size: 0.85rem;
            word-break: break-all;
            text-align: center;
            max-width: 100%;
            flex: 1 1 auto;
            min-width: 120px;
        }

        .address-row .btn-copy {
            background: #f8fafc !important;
            border: 1px solid #e2e8f0 !important;
            color: #64748b !important;
            border-radius: 2rem !important;
            padding: 0.3rem 0.7rem !important;
            font-size: 0.8rem;
            transition: all 0.2s ease;
            flex-shrink: 0;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .address-row .btn-copy:hover {
            background: #eff6ff !important;
            border-color: #2563eb !important;
            color: #2563eb !important;
        }

        /* --- Network Badges --- */
        .network-badges {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 0.6rem;
        }

        .network-badges .badge {
            font-weight: 600;
            padding: 0.35rem 0.9rem;
            border-radius: 2rem;
            font-size: 0.7rem;
            letter-spacing: 0.2px;
        }

        .badge-bg-info {
            background: #e0f2fe !important;
            color: #0369a1 !important;
        }

        .badge-bg-warning {
            background: #fef9c3 !important;
            color: #854d0e !important;
        }

        .tab-pane .text-muted.small {
            font-size: 0.8rem;
            color: #64748b !important;
            margin-top: 0.5rem;
        }

        /* ===== DIVIDER ===== */
        hr {
            border: 0;
            height: 1px;
            background: #e9edf2;
            margin: 1.8rem 0;
        }

        /* ===== FORM HEADING ===== */
        .card-body h5 {
            font-weight: 700;
            font-size: 1.15rem;
            color: #0f172a;
            margin-bottom: 1.25rem;
        }

        /* ===== FORM LABELS ===== */
        .form-label {
            color: #334155;
            font-weight: 600;
            font-size: 0.88rem;
            letter-spacing: 0.2px;
            margin-bottom: 0.35rem;
            display: block;
        }

        /* ===== INPUTS ===== */
        .form-control {
            background: #ffffff !important;
            border: 1.5px solid #e2e8f0 !important;
            border-radius: 1rem !important;
            padding: 0.75rem 1.1rem !important;
            color: #1e293b !important;
            font-size: 1rem;
            font-weight: 500;
            transition: all 0.25s ease;
            width: 100%;
            outline: none;
        }

        .form-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .form-control:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10) !important;
        }

        .mb-3 {
            margin-bottom: 1.35rem !important;
        }

        /* ===== SUBMIT BUTTON ===== */
        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8) !important;
            border: none !important;
            border-radius: 1rem !important;
            padding: 0.85rem 1.5rem !important;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 0.3px;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.20);
            transition: all 0.3s ease;
            cursor: pointer;
            width: 100%;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.30);
            background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        .text-muted.small.text-center {
            font-size: 0.8rem;
            color: #94a3b8 !important;
            margin-top: 1.25rem !important;
        }

        /* ============================================================ */
        /* ===== RESPONSIVE — MOBILE FIRST ===== */
        /* ============================================================ */

        @media (max-width: 575.98px) {
            body {
                padding: 0.6rem;
            }

            .card {
                border-radius: 1.5rem !important;
            }

            .card-header {
                padding: 1.1rem 1.1rem !important;
            }

            .card-header h4 {
                font-size: 1.2rem;
            }

            .card-header h4 i {
                font-size: 1.1rem;
            }

            .card-body {
                padding: 1.25rem 1.1rem !important;
            }

            /* --- TABS --- */
            .nav-pills {
                gap: 0.35rem;
                padding: 0.4rem;
                border-radius: 1rem;
            }

            .nav-pills .nav-link {
                padding: 0.5rem 0.4rem !important;
                font-size: 0.65rem;
                border-radius: 0.75rem !important;
                gap: 0.3rem;
            }

            .nav-pills .nav-link i {
                font-size: 0.75rem;
            }

            /* --- QR --- */
            .tab-pane .text-center img {
                max-width: 140px;
                padding: 0.4rem;
            }

            .address-row .address-text {
                font-size: 0.72rem;
                padding: 0.2rem 0.7rem;
                min-width: 80px;
            }

            .address-row .btn-copy {
                font-size: 0.65rem;
                padding: 0.2rem 0.5rem !important;
            }

            .network-badges .badge {
                font-size: 0.6rem;
                padding: 0.25rem 0.7rem;
            }

            .tab-pane .text-muted.small {
                font-size: 0.7rem;
            }

            /* --- FORM --- */
            .card-body h5 {
                font-size: 1rem;
            }

            .form-label {
                font-size: 0.78rem;
            }

            .form-control {
                padding: 0.6rem 0.85rem !important;
                font-size: 0.9rem;
                border-radius: 0.85rem !important;
            }

            .btn-primary {
                padding: 0.7rem 1rem !important;
                font-size: 0.9rem;
                border-radius: 0.85rem !important;
            }

            .mb-3 {
                margin-bottom: 1rem !important;
            }

            hr {
                margin: 1.25rem 0;
            }
        }

        /* ===== TABLET (SMALL) ===== */
        @media (min-width: 576px) and (max-width: 767.98px) {
            .card-header {
                padding: 1.4rem 1.5rem !important;
            }
            .card-body {
                padding: 1.5rem 1.5rem !important;
            }

            .nav-pills .nav-link {
                font-size: 0.75rem;
                padding: 0.55rem 0.6rem !important;
            }

            .tab-pane .text-center img {
                max-width: 160px;
            }
        }

        /* ===== TABLET (LARGE) ===== */
        @media (min-width: 768px) and (max-width: 991.98px) {
            .card-header {
                padding: 1.6rem 1.8rem !important;
            }
            .card-body {
                padding: 1.8rem 1.8rem !important;
            }

            .nav-pills .nav-link {
                font-size: 0.8rem;
                padding: 0.6rem 0.7rem !important;
            }
        }

        /* ===== DESKTOP ===== */
        @media (min-width: 992px) {
            .card-header {
                padding: 1.75rem 2.25rem !important;
            }
            .card-body {
                padding: 2.25rem 2.25rem !important;
            }
        }

        /* ============================================================ */
        /* ===== TOUCH DEVICES — DISABLE HOVER EFFECTS ===== */
        /* ============================================================ */
        @media (hover: none) and (pointer: coarse) {
            .btn-primary:hover {
                transform: none !important;
                box-shadow: 0 8px 20px rgba(37, 99, 235, 0.20) !important;
            }
            .tab-pane .text-center img:hover {
                transform: none !important;
            }
            .address-row .btn-copy:hover {
                background: #f8fafc !important;
                border-color: #e2e8f0 !important;
                color: #64748b !important;
            }
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
                animation: none !important;
            }
            .btn-primary:hover {
                transform: none !important;
            }
        }

        /* ===== SAFE AREA ===== */
        @supports (padding: max(0px)) {
            body {
                padding-left: max(1.25rem, env(safe-area-inset-left));
                padding-right: max(1.25rem, env(safe-area-inset-right));
                padding-top: max(1.25rem, env(safe-area-inset-top));
                padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
            }
        }

        /* ===== TOAST ===== */
        .position-fixed.top-0.start-50.translate-middle-x {
            transform: translateX(-50%) !important;
        }
        .position-fixed {
            z-index: 9999 !important;
        }
    </style>
</head>
<body>

    <div class="row justify-content-center" style="width:100%; margin:0; max-width:700px;">
        <div class="col-md-8 col-lg-6" style="width:100%; padding:0;">
            <div class="card shadow">
                <div class="card-header bg-transparent">
                    <h4 class="mb-0"><i class="fas fa-credit-card me-2"></i>Deposit Funds</h4>
                </div>
                <div class="card-body">

                    <!-- ===== DEPOSIT METHOD TABS ===== -->
                    <ul class="nav nav-pills nav-fill mb-4" id="depositTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-upi" data-bs-toggle="pill" data-bs-target="#panel-upi" type="button" role="tab">
                                <i class="fas fa-mobile-alt"></i> UPI
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-trc20" data-bs-toggle="pill" data-bs-target="#panel-trc20" type="button" role="tab">
                                <i class="fab fa-bitcoin"></i> TRC20
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-erc20" data-bs-toggle="pill" data-bs-target="#panel-erc20" type="button" role="tab">
                                <i class="fab fa-ethereum"></i> ERC20
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-bep20" data-bs-toggle="pill" data-bs-target="#panel-bep20" type="button" role="tab">
                                <i class="fas fa-link"></i> BEP20
                            </button>
                        </li>
                    </ul>

                    <!-- ===== TAB PANELS ===== -->
                    <div class="tab-content" id="depositTabContent">

                        <!-- PANEL 1: UPI -->
                        <div class="tab-pane fade show active" id="panel-upi" role="tabpanel">
                            <div class="text-center">
                                <img src="<%= typeof qrImage !== 'undefined' ? qrImage : '/images/upi-qr.png' %>" alt="UPI QR" class="img-fluid border shadow rounded" style="max-width:200px;">
                                <p class="mt-2 mb-1"><strong>UPI ID:</strong></p>
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <span class="text-primary fw-bold"><%= typeof upiId !== 'undefined' ? upiId : 'example@upi' %></span>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyText('<%= typeof upiId !== 'undefined' ? upiId : 'example@upi' %>')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                                <p class="text-muted small mt-2">Scan the QR code or copy the UPI ID and pay the exact amount.</p>
                            </div>
                        </div>

                        <!-- PANEL 2: USDT TRC20 -->
                        <div class="tab-pane fade" id="panel-trc20" role="tabpanel">
                            <div class="text-center">
                                <img src="<%= typeof usdtTrc20Qr !== 'undefined' ? usdtTrc20Qr : '/images/usdt-trc20-qr.png' %>" alt="USDT TRC20 QR" class="img-fluid border shadow rounded" style="max-width:200px;">
                                <p class="mt-2 mb-1"><strong>Wallet Address (TRC20):</strong></p>
                                <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                    <span class="text-primary fw-bold small" style="word-break:break-all;"><%= typeof usdtTrc20Address !== 'undefined' ? usdtTrc20Address : 'TXYZ...1234' %></span>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyText('<%= typeof usdtTrc20Address !== 'undefined' ? usdtTrc20Address : 'TXYZ...1234' %>')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                                <p class="text-muted small mt-2">
                                    <span class="badge bg-info text-dark">Network: TRC20</span>
                                    <span class="badge bg-warning text-dark ms-1">Token: USDT</span>
                                </p>
                                <p class="text-muted small">Send USDT on the TRC20 network to the address above.</p>
                            </div>
                        </div>

                        <!-- PANEL 3: USDT ERC20 -->
                        <div class="tab-pane fade" id="panel-erc20" role="tabpanel">
                            <div class="text-center">
                                <img src="<%= typeof usdtErc20Qr !== 'undefined' ? usdtErc20Qr : '/images/usdt-erc20-qr.png' %>" alt="USDT ERC20 QR" class="img-fluid border shadow rounded" style="max-width:200px;">
                                <p class="mt-2 mb-1"><strong>Wallet Address (ERC20):</strong></p>
                                <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                    <span class="text-primary fw-bold small" style="word-break:break-all;"><%= typeof usdtErc20Address !== 'undefined' ? usdtErc20Address : '0xABC...789' %></span>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyText('<%= typeof usdtErc20Address !== 'undefined' ? usdtErc20Address : '0xABC...789' %>')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                                <p class="text-muted small mt-2">
                                    <span class="badge bg-info text-dark">Network: ERC20</span>
                                    <span class="badge bg-warning text-dark ms-1">Token: USDT</span>
                                </p>
                                <p class="text-muted small">Send USDT on the ERC20 network to the address above.</p>
                            </div>
                        </div>

                        <!-- PANEL 4: USDT BEP20 -->
                        <div class="tab-pane fade" id="panel-bep20" role="tabpanel">
                            <div class="text-center">
                                <img src="<%= typeof usdtBep20Qr !== 'undefined' ? usdtBep20Qr : '/images/usdt-bep20-qr.png' %>" alt="USDT BEP20 QR" class="img-fluid border shadow rounded" style="max-width:200px;">
                                <p class="mt-2 mb-1"><strong>Wallet Address (BEP20):</strong></p>
                                <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                    <span class="text-primary fw-bold small" style="word-break:break-all;"><%= typeof usdtBep20Address !== 'undefined' ? usdtBep20Address : '0xDEF...456' %></span>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyText('<%= typeof usdtBep20Address !== 'undefined' ? usdtBep20Address : '0xDEF...456' %>')">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                                <p class="text-muted small mt-2">
                                    <span class="badge bg-info text-dark">Network: BEP20</span>
                                    <span class="badge bg-warning text-dark ms-1">Token: USDT</span>
                                </p>
                                <p class="text-muted small">Send USDT on the BEP20 network to the address above.</p>
                            </div>
                        </div>

                    </div>

                    <hr>

                    <!-- ===== DEPOSIT FORM ===== -->
                    <h5>Submit Payment Details</h5>
                    <form action="/deposit" method="POST" id="depositForm">
                        <input type="hidden" name="method" id="depositMethod" value="upi">

                        <div class="mb-3">
                            <label for="amount" class="form-label" id="amountLabel">Amount (₹)</label>
                            <input type="number" class="form-control" id="amount" name="amount" min="1" step="any" placeholder="Enter amount" required>
                        </div>

                        <div class="mb-3">
                            <label for="utr" class="form-label" id="utrLabel">UTR Number</label>
                            <input type="text" class="form-control" id="utr" name="utr" placeholder="Enter UTR / Transaction ID" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-paper-plane me-2"></i>Submit Deposit Request
                        </button>
                    </form>

                    <p class="text-muted small text-center mt-3 mb-0">
                        <i class="fas fa-info-circle me-1"></i> Your deposit will be processed after verification.
                    </p>

                </div>
            </div>
        </div>
    </div>

    <!-- ===== JAVASCRIPT ===== -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tabs = document.querySelectorAll('#depositTabs .nav-link');
            const methodInput = document.getElementById('depositMethod');
            const amountLabel = document.getElementById('amountLabel');
            const utrLabel = document.getElementById('utrLabel');
            const amountInput = document.getElementById('amount');
            const utrInput = document.getElementById('utr');

            const config = {
                'tab-upi': {
                    method: 'upi',
                    amountLabel: 'Amount (₹)',
                    utrLabel: 'UTR Number',
                    amountPlaceholder: 'Enter amount in ₹',
                    utrPlaceholder: 'Enter UTR number'
                },
                'tab-trc20': {
                    method: 'usdt_trc20',
                    amountLabel: 'Amount (USDT)',
                    utrLabel: 'Transaction Hash (TXN)',
                    amountPlaceholder: 'Enter USDT amount',
                    utrPlaceholder: 'Enter transaction hash'
                },
                'tab-erc20': {
                    method: 'usdt_erc20',
                    amountLabel: 'Amount (USDT)',
                    utrLabel: 'Transaction Hash (TXN)',
                    amountPlaceholder: 'Enter USDT amount',
                    utrPlaceholder: 'Enter transaction hash'
                },
                'tab-bep20': {
                    method: 'usdt_bep20',
                    amountLabel: 'Amount (USDT)',
                    utrLabel: 'Transaction Hash (TXN)',
                    amountPlaceholder: 'Enter USDT amount',
                    utrPlaceholder: 'Enter transaction hash'
                }
            };

            function updateForm(tabId) {
                const cfg = config[tabId];
                if (!cfg) return;

                methodInput.value = cfg.method;
                amountLabel.textContent = cfg.amountLabel;
                utrLabel.textContent = cfg.utrLabel;
                amountInput.placeholder = cfg.amountPlaceholder;
                utrInput.placeholder = cfg.utrPlaceholder;
                amountInput.min = cfg.method === 'upi' ? 1 : 0.01;
                amountInput.step = cfg.method === 'upi' ? 'any' : '0.01';
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', function(e) {
                    setTimeout(() => {
                        updateForm(this.id);
                    }, 50);
                });
            });

            const activeTab = document.querySelector('#depositTabs .nav-link.active');
            if (activeTab) {
                updateForm(activeTab.id);
            }
        });

        function copyText(text) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast('Copied!', 'Address copied to clipboard.');
                }).catch(() => {
                    fallbackCopy(text);
                });
            } else {
                fallbackCopy(text);
            }
        }

        function fallbackCopy(text) {
            const el = document.createElement('textarea');
            el.value = text;
            el.style.position = 'fixed';
            el.style.left = '-9999px';
            document.body.appendChild(el);
            el.select();
            try {
                document.execCommand('copy');
                showToast('Copied!', 'Address copied to clipboard.');
            } catch (e) {
                showToast('Error', 'Could not copy. Please copy manually.', 'danger');
            }
            document.body.removeChild(el);
        }

        function showToast(title, message, type) {
            type = type || 'success';
            const bg = type === 'danger' ? 'bg-danger' : 'bg-success';
            const toast = document.createElement('div');
            toast.className =
                `position-fixed top-0 start-50 translate-middle-x mt-3 px-4 py-2 rounded text-white ${bg} shadow`;
            toast.style.zIndex = '9999';
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            toast.innerHTML = `<strong>${title}</strong> ${message}`;
            document.body.appendChild(toast);
            requestAnimationFrame(() => {
                toast.style.opacity = '1';
            });
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 400);
            }, 2500);
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>