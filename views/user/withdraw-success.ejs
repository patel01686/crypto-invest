<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-primary">
            <div class="card-body text-center">
                <i class="fas fa-clock text-primary display-1"></i>
                <h3 class="mt-3">Withdrawal Request Submitted ⏳</h3>
                <p class="lead">Your withdrawal of <strong>₹<%= transaction.amount.toFixed(2) %></strong> is pending admin approval.</p>
                <p>Status: <span class="badge bg-warning">Pending</span></p>
                
                <hr>
                <p class="text-muted">Notify the admin to speed up the process:</p>
                <a href="<%= waLink %>" target="_blank" class="btn btn-success btn-lg mt-2">
                    <i class="fab fa-whatsapp me-2"></i> Notify Admin via WhatsApp
                </a>
                <p class="text-muted mt-3">
                    <small>Click the button to open WhatsApp with pre-filled message.</small>
                </p>
                <a href="/dashboard" class="btn btn-outline-primary mt-3">Back to Dashboard</a>
            </div>
        </div>
    </div>
</div>