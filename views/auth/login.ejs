<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title>Login</title>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* ===== RESET & BASE – LIGHT THEME ===== */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
            background: linear-gradient(135deg, #f0f4ff 0%, #e8edf5 50%, #dce3ef 100%);
            background-attachment: fixed;
            padding: 1.25rem;
            margin: 0;
        }

        /* ===== CARD – LIGHT, CLEAN, MODERN ===== */
        .card {
            background: rgba(255, 255, 255, 0.92) !important;
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.50) !important;
            border-radius: 2.5rem !important;
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.06),
                0 8px 24px rgba(0, 0, 0, 0.04),
                inset 0 1px 0 rgba(255, 255, 255, 0.80) !important;
            transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.4s ease;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow:
                0 32px 72px rgba(0, 0, 0, 0.08),
                0 12px 32px rgba(0, 0, 0, 0.05),
                inset 0 1px 0 rgba(255, 255, 255, 0.90) !important;
        }

        .card-body {
            padding: 2.5rem 2rem !important;
        }

        /* ===== HEADING ===== */
        h3 {
            color: #1a1a2e;
            font-weight: 700;
            font-size: 1.85rem;
            letter-spacing: -0.4px;
            margin-bottom: 2rem !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
        }

        h3 i {
            color: #4f6ef7;
            font-size: 1.6rem;
            filter: drop-shadow(0 0 12px rgba(79, 110, 247, 0.20));
        }

        /* ===== FORM LABELS ===== */
        .form-label {
            color: #2d3748;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.3px;
            margin-bottom: 0.4rem;
            display: block;
        }

        /* ===== INPUTS – LIGHT STYLE ===== */
        .form-control {
            background: #f7f9fc !important;
            border: 1.5px solid #e2e8f0 !important;
            border-radius: 1.25rem !important;
            padding: 0.85rem 1.2rem !important;
            color: #1a202c !important;
            font-size: 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
            width: 100%;
            outline: none;
        }

        .form-control::placeholder {
            color: #a0aec0;
            font-weight: 400;
        }

        .form-control:focus {
            background: #ffffff !important;
            border-color: #4f6ef7 !important;
            box-shadow:
                0 0 0 4px rgba(79, 110, 247, 0.10),
                inset 0 2px 4px rgba(0, 0, 0, 0.02) !important;
            transform: scale(1.01);
        }

        .form-control:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 1000px #f7f9fc inset !important;
            -webkit-text-fill-color: #1a202c !important;
            border-color: #4f6ef7 !important;
        }

        /* ===== INPUT WRAPPER ===== */
        .mb-3 {
            margin-bottom: 1.5rem !important;
        }

        /* ===== BUTTON – BRIGHT, GRADIENT ===== */
        .btn-primary {
            background: linear-gradient(135deg, #4f6ef7, #7c3aed) !important;
            border: none !important;
            border-radius: 1.25rem !important;
            padding: 0.9rem 1.5rem !important;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 0.4px;
            color: #fff;
            box-shadow:
                0 8px 28px rgba(79, 110, 247, 0.30),
                inset 0 1px 0 rgba(255, 255, 255, 0.20);
            transition: all 0.3s ease;
            cursor: pointer;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 1.25rem;
            background: linear-gradient(135deg, transparent 40%, rgba(255, 255, 255, 0.12) 100%);
            pointer-events: none;
        }

        .btn-primary:hover {
            transform: translateY(-2px) scale(1.01);
            box-shadow:
                0 14px 40px rgba(79, 110, 247, 0.40),
                inset 0 1px 0 rgba(255, 255, 255, 0.25);
            background: linear-gradient(135deg, #5f7cff, #8b5cf6) !important;
        }

        .btn-primary:active {
            transform: scale(0.97);
            box-shadow: 0 4px 16px rgba(79, 110, 247, 0.25);
        }

        /* ===== REGISTER LINK ===== */
        .text-center.mt-3 {
            color: #4a5568;
            font-size: 0.95rem;
            margin-top: 1.8rem !important;
            text-align: center;
        }

        .text-center.mt-3 a {
            color: #4f6ef7;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.25s ease;
            border-bottom: 2px solid transparent;
            padding-bottom: 2px;
        }

        .text-center.mt-3 a:hover {
            color: #7c3aed;
            border-bottom-color: #4f6ef7;
        }

        /* ============================================================ */
        /* ===== RESPONSIVE – COMPREHENSIVE ===== */
        /* ============================================================ */

        /* --- Extra Small (xs) < 576px --- */
        @media (max-width: 575.98px) {
            body {
                padding: 0.75rem;
                align-items: center;
                min-height: 100dvh;
            }

            .card {
                border-radius: 1.75rem !important;
                box-shadow: 0 16px 48px rgba(0, 0, 0, 0.06) !important;
            }
            .card:hover {
                transform: none !important;
            }

            .card-body {
                padding: 1.75rem 1.25rem !important;
            }

            h3 {
                font-size: 1.5rem;
                gap: 0.4rem;
                margin-bottom: 1.5rem !important;
            }

            h3 i {
                font-size: 1.3rem;
            }

            .form-label {
                font-size: 0.8rem;
            }

            .form-control {
                padding: 0.75rem 1rem !important;
                font-size: 0.95rem;
                border-radius: 1rem !important;
            }

            .btn-primary {
                padding: 0.8rem 1.2rem !important;
                font-size: 0.95rem;
                border-radius: 1rem !important;
            }

            .text-center.mt-3 {
                font-size: 0.85rem;
                margin-top: 1.4rem !important;
            }

            .mb-3 {
                margin-bottom: 1.2rem !important;
            }
        }

        /* --- Small (sm) 576px – 767px --- */
        @media (min-width: 576px) and (max-width: 767.98px) {
            .card-body {
                padding: 2.25rem 1.75rem !important;
            }

            .card {
                border-radius: 2rem !important;
            }
        }

        /* --- Medium (md) 768px – 991px --- */
        @media (min-width: 768px) and (max-width: 991.98px) {
            .card-body {
                padding: 2.75rem 2.5rem !important;
            }

            .card {
                border-radius: 2.25rem !important;
            }
        }

        /* --- Large (lg) 992px – 1199px --- */
        @media (min-width: 992px) and (max-width: 1199.98px) {
            .card-body {
                padding: 3rem 2.75rem !important;
            }

            .card {
                border-radius: 2.75rem !important;
            }
        }

        /* --- Extra Large (xl) 1200px+ --- */
        @media (min-width: 1200px) {
            .card-body {
                padding: 3.25rem 3.25rem !important;
            }

            .card {
                border-radius: 3rem !important;
            }
        }

        /* --- Very small screens (<= 360px) --- */
        @media (max-width: 360px) {
            body {
                padding: 0.5rem;
            }

            .card-body {
                padding: 1.5rem 1rem !important;
            }

            h3 {
                font-size: 1.25rem;
            }

            .form-control {
                padding: 0.65rem 0.85rem !important;
                font-size: 0.85rem;
            }

            .btn-primary {
                padding: 0.7rem 1rem !important;
                font-size: 0.85rem;
            }

            .text-center.mt-3 {
                font-size: 0.75rem;
            }
        }

        /* --- Landscape phones & small devices --- */
        @media (max-height: 600px) and (orientation: landscape) {
            body {
                padding: 0.5rem 1rem;
                min-height: 100vh;
            }

            .card-body {
                padding: 1.25rem 1.5rem !important;
            }

            h3 {
                font-size: 1.3rem;
                margin-bottom: 1rem !important;
            }

            .mb-3 {
                margin-bottom: 0.8rem !important;
            }

            .form-control {
                padding: 0.5rem 0.9rem !important;
                font-size: 0.85rem;
            }

            .btn-primary {
                padding: 0.5rem 1rem !important;
                font-size: 0.85rem;
            }

            .text-center.mt-3 {
                margin-top: 1rem !important;
                font-size: 0.8rem;
            }
        }

        /* ===== TOUCH / CLICK IMPROVEMENTS ===== */
        @media (hover: none) and (pointer: coarse) {
            .btn-primary:hover {
                transform: none !important;
                box-shadow: 0 8px 28px rgba(79, 110, 247, 0.30) !important;
            }

            .card:hover {
                transform: none !important;
            }

            .form-control:focus {
                transform: none !important;
            }
        }

        /* ===== SAFE AREA FOR NOTCH PHONES ===== */
        @supports (padding: max(0px)) {
            body {
                padding-left: max(1.25rem, env(safe-area-inset-left));
                padding-right: max(1.25rem, env(safe-area-inset-right));
                padding-top: max(1.25rem, env(safe-area-inset-top));
                padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
            }
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            .card,
            .btn-primary,
            .form-control,
            .text-center.mt-3 a {
                transition: none !important;
                animation: none !important;
            }
            .card:hover {
                transform: none !important;
            }
            .btn-primary:hover {
                transform: none !important;
            }
        }

        /* ===== PRINT FRIENDLY ===== */
        @media print {
            body {
                background: #fff !important;
                padding: 0.5rem !important;
            }
            .card {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
                border-radius: 1rem !important;
            }
            .btn-primary {
                background: #4f6ef7 !important;
                color: #fff !important;
                box-shadow: none !important;
            }
            .card:hover {
                transform: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="row justify-content-center" style="width:100%; margin:0; max-width:540px;">
        <div class="col-md-6 col-lg-5" style="width:100%; padding:0;">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Login
                    </h3>
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="password" name="password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                    <p class="text-center mt-3">
                        Don't have an account? <a href="/register">Register</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>