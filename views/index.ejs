<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title>Coinswitch</title>

    <!-- Bootstrap 5 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f4f6fc;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        /* ===== HERO ===== */
        .hero-section {
            position: relative;
            width: 100%;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            margin: 0;
            background: transparent !important;
            overflow: visible;
        }

        .hero-section .hero-content {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1100px;
            padding: 4rem 2rem;
            margin: 0 auto;
            text-align: center;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(74, 95, 207, 0.08);
            padding: 0.5rem 1.8rem;
            border-radius: 60px;
            color: #4a5fcf;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            border: 1px solid rgba(74, 95, 207, 0.12);
            margin-bottom: 1.8rem;
            transition: all 0.3s ease;
        }

        .hero-badge:hover {
            background: rgba(74, 95, 207, 0.15);
            transform: scale(1.04);
        }

        .hero-title {
            font-size: 4rem;
            font-weight: 800;
            line-height: 1.08;
            color: #0f1a2e;
            margin-bottom: 1.2rem;
            letter-spacing: -0.02em;
        }

        .hero-title .gradient-text {
            background: linear-gradient(135deg, #4a5fcf, #6a3f9e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: #4a5568;
            max-width: 680px;
            margin: 0 auto 1.2rem;
            line-height: 1.8;
            font-weight: 300;
        }

        .hero-subtitle strong {
            color: #4a5fcf;
            font-weight: 600;
        }

        .hero-promo {
            display: inline-block;
            background: linear-gradient(135deg, #f7e9b0, #f5d98a);
            padding: 0.5rem 1.5rem;
            border-radius: 60px;
            color: #0f1a2e;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 12px rgba(201, 168, 76, 0.25);
            margin-bottom: 1.8rem;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .hero-promo i {
            margin-right: 6px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
        }

        .hero-buttons .btn {
            padding: 0.8rem 2.4rem;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            letter-spacing: 0.3px;
        }

        .hero-buttons .btn-primary {
            background: linear-gradient(135deg, #4a5fcf, #6a3f9e);
            border: none;
            color: #fff;
            box-shadow: 0 4px 20px rgba(74, 95, 207, 0.25);
        }

        .hero-buttons .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 40px rgba(74, 95, 207, 0.35);
        }

        .hero-buttons .btn-outline-secondary {
            border: 1.5px solid #d1d9e6;
            color: #2d3748;
            background: transparent;
        }

        .hero-buttons .btn-outline-secondary:hover {
            background: #f0f4ff;
            border-color: #4a5fcf;
            transform: translateY(-3px);
        }

        /* ===== PLANS SECTION ===== */
        .plans-section {
            padding: 5rem 2rem 3rem;
            background: #f8faff;
            position: relative;
        }

        .plans-section .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0;
        }

        .plans-header {
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .plans-header .section-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, rgba(74, 95, 207, 0.08), rgba(106, 63, 158, 0.08));
            border-radius: 20px;
            font-size: 2rem;
            color: #4a5fcf;
            margin-bottom: 0.8rem;
            border: 1px solid rgba(74, 95, 207, 0.06);
        }

        .section-title {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, #1a1a2e, #2d2d6b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-subtitle {
            text-align: center;
            color: #6c757d;
            font-size: 1.1rem;
            max-width: 500px;
            margin: 0 auto;
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .plan-item {
            background: #ffffff;
            border-radius: 28px;
            padding: 2.2rem 1.8rem;
            text-align: center;
            border: 1px solid rgba(74, 95, 207, 0.06);
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.04);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
            overflow: hidden;
        }

        .plan-item::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 30px;
            padding: 2px;
            background: linear-gradient(135deg, #4a5fcf, #6a3f9e, #c9a84c, #6a3f9e, #4a5fcf);
            background-size: 300% 300%;
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.5s ease;
            animation: borderGlow 4s linear infinite;
        }

        .plan-item:hover::before {
            opacity: 1;
        }

        @keyframes borderGlow {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        .plan-item:hover {
            transform: translateY(-12px);
            box-shadow: 0 24px 70px rgba(74, 95, 207, 0.12);
        }

        .plan-item .plan-accent {
            width: 40px;
            height: 4px;
            border-radius: 4px;
            margin: 0 auto 1rem;
            background: linear-gradient(90deg, #4a5fcf, #6a3f9e);
            transition: width 0.4s ease;
        }

        .plan-item:hover .plan-accent {
            width: 60px;
        }

        .plan-item .plan-icon {
            font-size: 2.8rem;
            color: #4a5fcf;
            margin-bottom: 0.8rem;
            display: inline-block;
            background: rgba(74, 95, 207, 0.06);
            width: 72px;
            height: 72px;
            line-height: 72px;
            border-radius: 24px;
            transition: all 0.4s ease;
        }

        .plan-item:hover .plan-icon {
            background: linear-gradient(135deg, #4a5fcf, #6a3f9e);
            color: #fff;
            transform: scale(1.05) rotate(-4deg);
            box-shadow: 0 8px 30px rgba(74, 95, 207, 0.3);
        }

        .plan-item h3 {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 0.4rem;
            color: #1a1a2e;
        }

        .plan-item .plan-badge {
            display: inline-block;
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0.2rem 0.8rem;
            border-radius: 30px;
            background: rgba(74, 95, 207, 0.06);
            color: #4a5fcf;
            margin-bottom: 0.8rem;
        }

        .plan-item .plan-badge.popular {
            background: linear-gradient(135deg, #f7e9b0, #f5d98a);
            color: #0f1a2e;
        }

        .plan-desc {
            color: #6c757d;
            font-size: 0.95rem;
            margin-bottom: 1.2rem;
            min-height: 44px;
        }

        .plan-details {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            margin-bottom: 1.8rem;
            font-size: 0.95rem;
        }

        .plan-details span {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: #2d2d6b;
            background: rgba(74, 95, 207, 0.04);
            padding: 0.5rem 0.8rem;
            border-radius: 30px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .plan-item:hover .plan-details span {
            background: rgba(74, 95, 207, 0.08);
        }

        .plan-details i {
            color: #4a5fcf;
            width: 20px;
            font-size: 0.9rem;
        }

        .plan-item .btn-primary {
            background: linear-gradient(135deg, #4a5fcf 0%, #6a3f9e 100%);
            border: none;
            border-radius: 40px;
            padding: 0.7rem 2.2rem;
            font-weight: 600;
            color: #fff;
            transition: all 0.3s ease;
            box-shadow: 0 4px 16px rgba(74, 95, 207, 0.2);
            width: 100%;
        }

        .plan-item .btn-primary:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 35px rgba(74, 95, 207, 0.35);
        }

        .no-plans {
            text-align: center;
            padding: 3rem;
            background: rgba(0, 0, 0, 0.02);
            border-radius: 20px;
            color: #6c757d;
        }

        /* ===== DIVIDER ===== */
        .section-divider {
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #4a5fcf, #6a3f9e, #c9a84c, #4a5fcf, transparent);
            background-size: 300% 100%;
            animation: dividerMove 4s ease-in-out infinite;
            border: none;
            margin: 0;
            padding: 0;
            opacity: 0.5;
        }

        @keyframes dividerMove {
            0% {
                background-position: 0% 0%;
            }
            50% {
                background-position: 100% 0%;
            }
            100% {
                background-position: 0% 0%;
            }
        }

        /* ===== TRUST SECTION ===== */
        .trust-section {
            padding: 4rem 2rem 5rem;
            background: transparent !important;
        }

        .trust-section .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0;
        }

        .trust-grid {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 2rem;
            padding: 2rem 2.5rem;
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.04);
            transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
            overflow: hidden;
        }

        .trust-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient(180deg, #4a5fcf, #6a3f9e, #c9a84c);
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 20px 0 0 20px;
        }

        .trust-item:hover {
            transform: translateX(8px) scale(1.01);
            box-shadow: 0 12px 50px rgba(0, 0, 0, 0.08);
            background: rgba(255, 255, 255, 0.8);
        }

        .trust-item:hover::before {
            opacity: 1;
        }

        .trust-item .icon-wrapper {
            flex-shrink: 0;
            width: 72px;
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(74, 95, 207, 0.1), rgba(106, 63, 158, 0.1));
            border-radius: 18px;
            font-size: 2.4rem;
            color: #4a5fcf;
            transition: all 0.3s ease;
        }

        .trust-item:hover .icon-wrapper {
            background: linear-gradient(135deg, #4a5fcf, #6a3f9e);
            color: #fff;
            transform: scale(1.05) rotate(-3deg);
            box-shadow: 0 8px 30px rgba(74, 95, 207, 0.3);
        }

        .trust-item .content {
            flex: 1;
        }

        .trust-item .content h4 {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 0.3rem;
            color: #1a1a2e;
        }

        .trust-item .content p {
            color: #4a5568;
            font-size: 1rem;
            line-height: 1.6;
            margin: 0;
        }

        .trust-item .arrow {
            flex-shrink: 0;
            color: #c8d0e0;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .trust-item:hover .arrow {
            color: #4a5fcf;
            transform: translateX(6px);
        }

        /* ===== STATS ===== */
        .stats-section {
            background: #fff;
            padding: 3rem 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.03);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 2rem;
            max-width: 1100px;
            margin: 0 auto;
            text-align: center;
        }

        .stat-item h3 {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #4a5fcf, #6a3f9e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.2rem;
        }

        .stat-item p {
            color: #64748b;
            font-weight: 500;
            font-size: 0.95rem;
        }

        /* ===== HOW IT WORKS ===== */
        .how-section {
            background: #f8faff;
            padding: 4rem 1.5rem;
        }

        .how-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2.5rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .how-card {
            text-align: center;
            padding: 2rem 1.5rem;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            transition: 0.3s;
        }

        .how-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.04);
        }

        .how-card .icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, rgba(74, 95, 207, 0.08), rgba(106, 63, 158, 0.08));
            border-radius: 20px;
            font-size: 2.2rem;
            color: #4a5fcf;
            margin-bottom: 1rem;
        }

        .how-card h4 {
            font-size: 1.3rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.5rem;
        }

        .how-card p {
            color: #64748b;
            font-size: 0.95rem;
        }

        /* ===== TESTIMONIALS ===== */
        .testimonials-section {
            background: #fff;
            padding: 4rem 1.5rem;
        }

        .testimonial-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 2rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .testimonial-card {
            background: #f8faff;
            padding: 2rem 1.5rem;
            border-radius: 24px;
            border: 1px solid rgba(74, 95, 207, 0.04);
            transition: 0.3s;
        }

        .testimonial-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
        }

        .testimonial-card .avatar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .testimonial-card .avatar img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .testimonial-card .avatar .name {
            font-weight: 600;
            font-size: 1rem;
            color: #0f172a;
        }

        .testimonial-card .avatar .role {
            font-size: 0.8rem;
            color: #64748b;
        }

        .testimonial-card .quote {
            font-style: italic;
            color: #334155;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .testimonial-card .rating {
            color: #f59e0b;
            margin-top: 0.5rem;
        }

        /* ===== PROMO RIBBON ===== */
        .promo-ribbon {
            position: fixed;
            top: 20px;
            right: -35px;
            transform: rotate(45deg);
            background: linear-gradient(135deg, #c9a84c, #e8d070);
            color: #0a0e1a;
            padding: 5px 45px;
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 0 4px 25px rgba(201, 168, 76, 0.35);
            z-index: 9999;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        /* ===== TICKER ===== */
        @keyframes tickerScroll {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-50%);
            }
        }

        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.4;
                transform: scale(0.8);
            }
        }

        /* ============================================================ */
        /* ===== RESPONSIVE – COMPREHENSIVE FOR ALL DISPLAYS ===== */
        /* ============================================================ */

        /* --- Extra Small (xs) < 576px --- */
        @media (max-width: 575.98px) {
            /* Hero */
            .hero-section {
                min-height: 70vh;
            }
            .hero-section .hero-content {
                padding: 2.5rem 1.2rem;
            }
            .hero-title {
                font-size: 2rem;
                line-height: 1.15;
            }
            .hero-title br {
                display: none;
            }
            .hero-subtitle {
                font-size: 0.95rem;
                line-height: 1.6;
                padding: 0 0.2rem;
            }
            .hero-badge {
                font-size: 0.65rem;
                padding: 0.25rem 1rem;
                margin-bottom: 1.2rem;
            }
            .hero-promo {
                font-size: 0.7rem;
                padding: 0.3rem 1rem;
                margin-bottom: 1.2rem;
                display: block;
                width: 100%;
                max-width: 300px;
                margin-left: auto;
                margin-right: auto;
            }
            .hero-buttons {
                flex-direction: column;
                align-items: center;
                gap: 0.7rem;
            }
            .hero-buttons .btn {
                font-size: 0.85rem;
                padding: 0.6rem 1.6rem;
                width: 100%;
                max-width: 280px;
            }

            /* Promo Ribbon */
            .promo-ribbon {
                display: none;
            }

            /* Section Titles */
            .section-title {
                font-size: 1.8rem;
            }
            .section-subtitle {
                font-size: 0.95rem;
                padding: 0 0.5rem;
            }

            /* Plans */
            .plans-section {
                padding: 2.5rem 0.8rem 2rem;
            }
            .plans-header {
                margin-bottom: 2rem;
            }
            .plans-grid {
                grid-template-columns: 1fr;
                gap: 1.2rem;
            }
            .plan-item {
                padding: 1.6rem 1.2rem;
                border-radius: 20px;
            }
            .plan-item .plan-icon {
                width: 56px;
                height: 56px;
                line-height: 56px;
                font-size: 2rem;
                border-radius: 18px;
            }
            .plan-item h3 {
                font-size: 1.3rem;
            }
            .plan-desc {
                font-size: 0.85rem;
                min-height: auto;
            }
            .plan-details {
                font-size: 0.85rem;
                gap: 0.4rem;
            }
            .plan-details span {
                padding: 0.4rem 0.6rem;
                font-size: 0.8rem;
            }
            .plan-item .btn-primary {
                font-size: 0.85rem;
                padding: 0.6rem 1.2rem;
            }

            /* Trust */
            .trust-section {
                padding: 2rem 1rem 3rem;
            }
            .trust-item {
                flex-direction: column;
                text-align: center;
                padding: 1.5rem 1.2rem;
                gap: 0.8rem;
                border-radius: 16px;
            }
            .trust-item::before {
                width: 100%;
                height: 4px;
                border-radius: 0 0 16px 16px;
                top: 0;
                left: 0;
                right: 0;
                bottom: auto;
            }
            .trust-item:hover {
                transform: translateY(-4px) scale(1.01);
            }
            .trust-item .icon-wrapper {
                width: 56px;
                height: 56px;
                font-size: 1.6rem;
                border-radius: 14px;
            }
            .trust-item .content h4 {
                font-size: 1.05rem;
            }
            .trust-item .content p {
                font-size: 0.85rem;
            }
            .trust-item .arrow {
                display: none;
            }

            /* Stats */
            .stats-section {
                padding: 2rem 1rem;
            }
            .stats-grid {
                grid-template-columns: 1fr 1fr;
                gap: 1.2rem;
            }
            .stat-item h3 {
                font-size: 1.8rem;
            }
            .stat-item p {
                font-size: 0.8rem;
            }

            /* How It Works */
            .how-section {
                padding: 2.5rem 1rem;
            }
            .how-grid {
                grid-template-columns: 1fr;
                gap: 1.2rem;
            }
            .how-card {
                padding: 1.5rem 1.2rem;
                border-radius: 18px;
            }
            .how-card .icon {
                width: 60px;
                height: 60px;
                font-size: 1.8rem;
                border-radius: 16px;
            }
            .how-card h4 {
