                    <div class="arrow"><i class="fas fa-chevron-right"></i></div>
                </div>
                <div class="trust-item">
                    <div class="icon-wrapper"><i class="fas fa-wallet"></i></div>
                    <div class="content">
                        <h4>Instant Withdrawals</h4>
                        <p>Withdraw your earnings instantly with zero processing delays or hidden fees.</p>
                    </div>
                    <div class="arrow"><i class="fas fa-chevron-right"></i></div>
